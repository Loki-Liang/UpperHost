{
  "schemaVersion": 1,
  "appProject": "app/OpenDeviceStudio.App/OpenDeviceStudio.App.csproj",
  "targetFramework": "net10.0-windows",
  "outputType": "WinExe",
  "useWpf": true,
  "requiredProjectReferences": [
    "../../src/OpenDeviceStudio.Starters/OpenDeviceStudio.Starters.csproj",
    "../../src/OpenDeviceStudio.Presentation.Wpf/OpenDeviceStudio.Presentation.Wpf.csproj"
  ],
  "forbidPackageReferencesInApp": true,
  "startupFile": "app/OpenDeviceStudio.App/App.xaml.cs",
  "requiredStartupTokens": [
    "OpenDeviceStudioApplication.CreateBuilder",
    "AddOpenDeviceStudioApplication",
    "_host.StartAsync",
    "_host.DisposeAsync"
  ],
  "configurationFile": "app/OpenDeviceStudio.App/appsettings.json",
  "defaultTransportType": "simulator",
  "requiredConfigurationPaths": [
    "OpenDeviceStudio:Transport:Type",
    "OpenDeviceStudio:Transport:Simulator:Name",
    "OpenDeviceStudio:Transport:Serial:PortName",
    "OpenDeviceStudio:Transport:Serial:BaudRate",
    "OpenDeviceStudio:Transport:Tcp:Host",
    "OpenDeviceStudio:Transport:Tcp:Port",
    "OpenDeviceStudio:Transport:Resilience:Enabled",
    "OpenDeviceStudio:Observability:ServiceName",
    "OpenDeviceStudio:Observability:Logging:File:Enabled",
    "OpenDeviceStudio:Observability:Otlp:Enabled",
    "OpenDeviceStudio:Acquisition:RawRecording:Enabled",
    "OpenDeviceStudio:Acquisition:RawRecording:RootDirectory",
    "OpenDeviceStudio:Acquisition:RawRecording:QueueCapacity",
    "OpenDeviceStudio:Acquisition:RawRecording:Durability"
  ]
}
