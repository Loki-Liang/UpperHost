    <ProjectReference Include="../../src/UpperHost.Starters/UpperHost.Starters.csproj" />
    <ProjectReference Include="../../src/UpperHost.Diagnostics/UpperHost.Diagnostics.csproj" />
    <ProjectReference Include="../../src/UpperHost.Presentation.Wpf/UpperHost.Presentation.Wpf.csproj" />
    <ProjectReference Include="../../src/UpperHost.Workbench.Application/UpperHost.Workbench.Application.csproj" />
  </ItemGroup>
</Project>
