{
  "$schema": "http://json.schemastore.org/template",
  "author": "UpperHost Contributors",
  "classifications": ["WPF", "Upper Computer", "Device", "Scaffold", "UpperHost"],
  "identity": "UpperHost.Templates.Wpf",
  "name": "UpperHost Industrial WPF Upper-Computer Scaffold",
  "shortName": "upperhost",
  "sourceName": "UpperHost.App",
  "preferNameDirectory": true,
  "symbols": {
    "transport": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "simulator",
      "description": "Default transport provider",
      "choices": [
        { "choice": "simulator", "description": "Deterministic simulator for development" },
        { "choice": "serial", "description": "Serial port transport" },
        { "choice": "tcp", "description": "TCP client transport" }
      ],
      "replaces": "__TRANSPORT__"
    }
  }
}
