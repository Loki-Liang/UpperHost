<UserControl x:Class="UpperHost.Presentation.Wpf.Controls.ParameterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UpperHost.Presentation.Wpf.Controls">
    <Grid>
        <DataGrid ItemsSource="{Binding Parameters, RelativeSource={RelativeSource AncestorType={x:Type local:ParameterEditor}}}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="*" />
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Apply" Padding="10,3" Margin="4,1" Tag="{Binding}" Click="Apply_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
