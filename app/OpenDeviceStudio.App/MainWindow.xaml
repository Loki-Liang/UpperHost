<Window x:Class="OpenDeviceStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDeviceStudio"
        Width="860"
        Height="520"
        MinWidth="720"
        MinHeight="420">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="OpenDeviceStudio" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="16"
                       Text="Industrial upper-computer development scaffold" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="18"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="The source scaffold is running." />
                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Text="Develop this repository directly as your product: add device capabilities, protocols/providers, workflows, acquisition logic, and product UI without generating a second project." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="18"
                Background="#0D000000"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Recommended product extension points" />
                <TextBlock Margin="0,10,0,0" Text="• Device semantics and capabilities" />
                <TextBlock Margin="0,6,0,0" Text="• Protocol / provider integration" />
                <TextBlock Margin="0,6,0,0" Text="• Control, automation, and acquisition workflows" />
                <TextBlock Margin="0,6,0,0" Text="• Product-specific WPF presentation" />
                <TextBlock Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Text="Reusable OpenDeviceStudio runtime modules stay under src/. Product-specific code starts from app/OpenDeviceStudio.App." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
